# =============================================================================
# SAYVIS Professional AI Agent - Environment Variables
# =============================================================================
# Copy to .env and edit values

# ---------------------------------------------------------------------------
# Core Services
# ---------------------------------------------------------------------------
POSTGRES_USER=sayvis
POSTGRES_PASSWORD=sayvis_secure_password_2024
POSTGRES_DB=sayvis_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# n8n
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Tehran
N8N_ENCRYPTION_KEY=please_change_this_to_random_32_chars

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.3:70b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# SAYVIS Agent Backend
# ---------------------------------------------------------------------------
SAYVIS_AGENT_HOST=0.0.0.0
SAYVIS_AGENT_PORT=8000
SAYVIS_ENV=development
SAYVIS_LOG_LEVEL=INFO
SAYVIS_SECRET_KEY=change_me_to_random_64_chars_secret_key_for_jwt
SAYVIS_API_KEY=sayvis_dev_api_key_12345

# AI Providers (optional fallbacks)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Security
ZERO_TRUST_ENABLED=true
EMERGENCY_LOCK=false
REQUIRE_HIGH_RISK_CONFIRMATION=true

# Features
ENABLE_TRADING=false
ENABLE_WEB_SEARCH=true
ENABLE_RAG=true
ENABLE_N8N_TOOLS=true

# n8n integration
N8N_API_URL=http://n8n:5678
N8N_API_KEY=

# Redis (optional, for short-term memory)
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# External Services
# ---------------------------------------------------------------------------
# For web search tool
TAVILY_API_KEY=
SERPAPI_API_KEY=

# For trading gateway
MT_BRIDGE_URL=
MT_BRIDGE_TOKEN=

# ---------------------------------------------------------------------------
# Docker Compose Profiles
# ---------------------------------------------------------------------------
# Use: cpu, gpu, gpu-nvidia
COMPOSE_PROFILES=cpu
