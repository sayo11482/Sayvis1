{
  "name": "SAYVIS RAG Auto-Ingestion",
  "nodes": [
    {
      "parameters": {
        "path": "sayvis-rag-ingestion",
        "options": {}
      },
      "id": "webhook-rag",
      "name": "Webhook RAG",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [460, 300],
      "webhookId": "sayvis-rag-webhook"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.first().json.content || $input.first().json.body?.content || '';\nconst source = $input.first().json.source || 'n8n-webhook';\nconst chunk_size = 500;\n\n// Simple chunking\nfunction chunkText(text, size, overlap) {\n  const chunks = [];\n  let start = 0;\n  while (start < text.length) {\n    chunks.push(text.slice(start, start + size));\n    start += size - overlap;\n  }\n  return chunks;\n}\n\nconst chunks = chunkText(content, chunk_size, 50);\n\nreturn chunks.map((chunk, idx) => ({\n  json: {\n    content: chunk,\n    source: source,\n    chunk_index: idx,\n    total_chunks: chunks.length,\n    original_length: content.length\n  }\n}));"
      },
      "id": "code-chunk",
      "name": "Chunk Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "http://agent:8000/api/v1/rag/ingest",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.content }}"
            },
            {
              "name": "source",
              "value": "={{ $json.source }}-chunk-{{ $json.chunk_index }}"
            },
            {
              "name": "metadata",
              "value": "={{ { chunk_index: $json.chunk_index, total_chunks: $json.total_chunks } }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batchSize": 5,
            "batchInterval": 1000
          }
        }
      },
      "id": "http-rag",
      "name": "Ingest to Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.points_ingested }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-success",
      "name": "Check Ingest",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseData": "={\n  \"success\": true,\n  \"ingested_chunks\": {{ $json.points_ingested || 0 }},\n  \"source\": \"{{ $('Webhook RAG').first().json.source }}\"\n}",
        "options": {}
      },
      "id": "respond-rag",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook RAG": {
      "main": [
        [
          {
            "node": "Chunk Document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chunk Document": {
      "main": [
        [
          {
            "node": "Ingest to Qdrant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest to Qdrant": {
      "main": [
        [
          {
            "node": "Check Ingest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Ingest": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "1.0",
  "id": "sayvis-rag-ingestion",
  "meta": {
    "instanceId": "sayvis-n8n"
  },
  "tags": [
    {
      "name": "sayvis"
    },
    {
      "name": "rag"
    }
  ]
}
