# ---------------------------------------------------------------------------
# SAYVIS build-time secrets (all OPTIONAL)
# ---------------------------------------------------------------------------
# Every credential below can also be entered at runtime by the owner in
# Settings → Artificial Intelligence & API, and is then stored encrypted in the
# Android Keystore. A packaged build therefore works with this file left empty:
# the owner simply types the key into the app and tests it with the built-in
# connection probe.
#
# A build-time value is only a convenience fallback for pre-provisioned builds.
# IMPORTANT: If left commented out, the key will NOT be packaged in the APK.

# GEMINI_API_KEY: used by the Gemini provider (AI Studio injects this from user secrets).
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENROUTER_API_KEY: used by the OpenRouter provider.
# OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# GROQ_API_KEY: used by the Groq provider.
# GROQ_API_KEY=MY_GROQ_API_KEY

# CUSTOM_AI_BASE_URL / CUSTOM_AI_API_KEY: used by the OpenAI-compatible provider.
# CUSTOM_AI_BASE_URL=https://my-gateway.local
# CUSTOM_AI_API_KEY=MY_CUSTOM_API_KEY
