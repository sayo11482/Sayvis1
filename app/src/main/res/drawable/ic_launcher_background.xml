<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. The colour stops are sampled from the edges of the
  SAYVIS artwork (art/sayvis-icon-master.png) so the foreground layer blends
  seamlessly when a launcher shifts it for parallax.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF0A0B0E" />
                <item android:offset="0.55" android:color="#FF0F1114" />
                <item android:offset="1" android:color="#FF1A1D22" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
